@@ -173,4 +173,38 @@
         }
 
 
+        // Apply the simulator's service and parking brakes independently from throttle.
+        public void ApplyBrakeInputs(float footbrake, float handbrake)
+        {
+            footbrake = Mathf.Clamp01(footbrake);
+            handbrake = Mathf.Clamp01(handbrake);
+            BrakeInput = footbrake;
+
+            if (footbrake <= 0f && handbrake <= 0f)
+            {
+                for (int i = 0; i < m_WheelColliders.Length; i++)
+                {
+                    if (m_WheelColliders[i] != null)
+                        m_WheelColliders[i].brakeTorque = 0f;
+                }
+                return;
+            }
+
+            AccelInput = 0f;
+            for (int i = 0; i < m_WheelColliders.Length; i++)
+            {
+                if (m_WheelColliders[i] == null) continue;
+                m_WheelColliders[i].motorTorque = 0f;
+                m_WheelColliders[i].brakeTorque = m_BrakeTorque * footbrake * 2.0f;
+            }
+            if (handbrake > 0f && m_WheelColliders.Length >= 4)
+            {
+                float torque = handbrake * m_MaxHandbrakeTorque;
+                if (m_WheelColliders[2] != null)
+                    m_WheelColliders[2].brakeTorque = Mathf.Max(m_WheelColliders[2].brakeTorque, torque);
+                if (m_WheelColliders[3] != null)
+                    m_WheelColliders[3].brakeTorque = Mathf.Max(m_WheelColliders[3].brakeTorque, torque);
+            }
+        }
+
         private void CapSpeed()
@@ -220,7 +254,7 @@
             for (int i = 0; i < 4; i++)
             {
                 if (CurrentSpeed > 5 && Vector3.Angle(transform.forward, m_Rigidbody.velocity) < 50f)
                 {
-                    m_WheelColliders[i].brakeTorque = m_BrakeTorque*footbrake;
+                    m_WheelColliders[i].brakeTorque = m_BrakeTorque*footbrake*2.0f;
                 }
                 else if (footbrake > 0)
                 {
