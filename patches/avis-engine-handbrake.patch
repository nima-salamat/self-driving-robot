# AVIS Engine Unity brake-protocol patch
# Target repository: AVISEngine/AVISEngine-Simulator
# Target revision: 4e14fdb24aead8feab5c50d08c36276a0f89b4f4
# Apply from the Unity project root:
#   git apply /path/to/avis-engine-handbrake.patch
#
# Adds backward-compatible FootBrake and Handbrake fields. Older six-field
# clients default both brake inputs to zero. Both the legacy negative-speed
# brake path and the explicit FootBrake path receive 2x service-brake torque.

diff --git a/Assets/Standard Assets/Vehicles/Car/Scripts/CarServer.cs b/Assets/Standard Assets/Vehicles/Car/Scripts/CarServer.cs
--- a/Assets/Standard Assets/Vehicles/Car/Scripts/CarServer.cs
+++ b/Assets/Standard Assets/Vehicles/Car/Scripts/CarServer.cs
@@ -42,3 +42,5 @@
     public float get_speed = 0;
     public float sensor_angle = 30;
+    public float Handbrake = 0;
+    public float FootBrake = 0;
 
@@ -67,1 +69,1 @@
-    string[] responseArray = {"0","0","0","0","0","0"};
+    string[] responseArray = {"0","0","0","0","0","0","0","0"};
@@ -122,2 +124,4 @@
             float.TryParse(responseArray[4], out get_speed);
             float.TryParse(responseArray[5], out sensor_angle);
+            float.TryParse(responseArray[6], out Handbrake);
+            float.TryParse(responseArray[7], out FootBrake);
@@ -221,2 +225,4 @@
                     float.TryParse(responseArray[4], out get_speed);
                     float.TryParse(responseArray[5], out sensor_angle);
+                    float.TryParse(responseArray[6], out Handbrake);
+                    float.TryParse(responseArray[7], out FootBrake);
@@ -280,5 +286,13 @@
             string[] arr = Regex.Matches(response, @"-?[0-9]\d*(.\d+)?")
                 .OfType<Match>()
                 .Select(m => m.Groups[0].Value)
                 .ToArray();
+            // Backward compatibility for six-field clients and early extensions.
+            if (arr.Length < 8)
+            {
+                int oldLength = arr.Length;
+                Array.Resize(ref arr, 8);
+                for (int i = oldLength; i < 8; i++)
+                    arr[i] = "0";
+            }
             return arr;
@@ -286,1 +300,1 @@
-            string[] arr = {"0","0","0","0","0","0"};
+            string[] arr = {"0","0","0","0","0","0","0","0"};
diff --git a/Assets/Standard Assets/Vehicles/Car/Scripts/CarController.cs b/Assets/Standard Assets/Vehicles/Car/Scripts/CarController.cs
